  "kind": "incident",
  "title": "The Courage of Captain Machchhar on Flydubai Flight 1073",
  "beats": [
    {
      "text": "On September 30, 2026, Flydubai Flight 1073 faced an attempted hijacking in Saudi Arabian airspace.",
      "shot": "photo:0",
      "card": {
        "big": "Flydubai Flight 1073",
        "small": ""
      },
      "pause_after": 0.3
    },
    {
      "text": "While flying near the Jordanian border, a violent struggle broke out in the cockpit.",
      "shot": "photo:1",
      "card": {
        "big": "Saudi Arabian border",
        "small": ""
      },
      "pause_after": 0.3
    },
    {
      "text": "The first officer attacked Captain Smit Machchhar with a crash axe and sent the plane into a steep descent.",
      "shot": "photo:2",
      "card": {
        "big": "Cockpit struggle",
        "small": ""
      },
      "pause_after": 0.3
    },
    {
      "text": "Despite being seriously wounded, Machchhar opened the cockpit door to admit passengers who restrained the first officer.",
      "shot": "photo:3",
      "card": {
        "big": "Captain Smit Machchhar",
        "small": ""
      },
      "pause_after": 0.3
    },
    {
      "text": "Two deadheading pilots then took control of the Boeing 737 MAX 8 and landed it safely in Tabuk.",
      "shot": "photo:0",
      "card": {
        "big": "Safe landing",
        "small": ""
      },
      "pause_after": 0.3
    },
    {
      "text": "Law enforcement agencies from Israel and the UAE are currently investigating the motives and the weapon used.",
      "shot": "photo:2",
      "card": {
        "big": "Official investigation",
        "small": ""
      },
      "pause_after": 0.3
    },
    {
      "text": "Flydubai confirmed all 172 passengers and 8 crew members were secure after the incident.",
      "shot": "photo:1",
      "card": {
        "big": "All passengers secure",
        "small": ""
      },
      "pause_after": 0.3
    },
    {
      "text": "The captain continues to receive medical treatment in the UAE.",
      "shot": "photo:3",
      "card": {
        "big": "Medical treatment",
        "small": ""
      },
      "pause_after": 0.3
    },
    {
      "text": "Follow Orbitwire for the stories the whole world is talking about.",
      "shot": "outro",
      "card": {
        "big": "Orbitwire",
        "small": "Sources in the description"
      },
      "pause_after": 0.5
    }
  ],
